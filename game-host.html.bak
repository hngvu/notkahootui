<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kahoot Clone - Host Control</title>
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/avatar.css">
</head>
<body>
    <div class="container">
        <h1>🎮 Điều khiển Game: <span id="game-id"></span></h1>
        
        <div class="game-controls">
            <button id="start-game" onclick="sendHostCommand('start_game')">Bắt đầu</button>
            <button id="next-question" onclick="sendHostCommand('next_question')">Câu hỏi tiếp</button>
            <button id="show-leaderboard" onclick="sendHostCommand('show_leaderboard')">Bảng xếp hạng</button>
            <button id="end-game" onclick="sendHostCommand('end_game')">Kết thúc</button>
        </div>
        
        <div class="game-info">
            <div id="player-list">
                <h3>Người chơi (<span id="player-count">0</span>)</h3>
                <div id="players-container"></div>
            </div>
            
            <div id="current-question" class="hidden">
                <h3>Câu hỏi hiện tại</h3>
                <p id="question-text"></p>
                <div id="question-options"></div>
            </div>
            
            <div id="leaderboard" class="hidden">
                <h3>Bảng xếp hạng</h3>
                <div id="leaderboard-content"></div>
            </div>
        </div>
    </div>
    
    <script src="js/game-host.js"></script>
</body>
</html>